# Hybrid News Analysis Configuration Example
# Copy this file to .env and customize as needed

# ========================================
# CORE HYBRID ANALYSIS SETTINGS
# ========================================

# Enable/disable the hybrid analysis system
HYBRID_ANALYSIS_ENABLED=true

# ========================================
# LLM FALLBACK CONFIGURATION
# ========================================

# Enable LLM fallback when rules fail
# Set to 'true' for full hybrid functionality
# Set to 'false' for rules-only processing (faster, no API costs)
HYBRID_LLM_FALLBACK_ENABLED=false

# Confidence threshold for LLM fallback trigger (0.0-1.0)
HYBRID_LLM_CONFIDENCE_THRESHOLD=0.7

# Maximum number of LLM API retries on failure
HYBRID_LLM_MAX_RETRIES=3

# LLM request timeout in milliseconds
HYBRID_LLM_TIMEOUT_MS=30000

# ========================================
# RULE-BASED PROCESSING CONFIGURATION
# ========================================

# Enable rule-based processing
HYBRID_RULES_ENABLED=true

# Minimum confidence threshold for rule matches (0.0-1.0)
HYBRID_RULES_CONFIDENCE_THRESHOLD=0.7

# Enable strict rule validation
HYBRID_RULES_STRICT_MODE=true

# ========================================
# LLM MODEL CONFIGURATION
# ========================================

# OpenRouter API key (required for LLM fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model to use
OPENROUTER_MODEL=openrouter/auto

# OpenRouter API base URL (optional)
OPENROUTER_BASE=https://openrouter.ai/api/v1

# LLM temperature setting (0.0-2.0)
HYBRID_LLM_TEMPERATURE=0.2

# Maximum tokens for LLM responses
HYBRID_LLM_MAX_TOKENS=2000

# ========================================
# VALIDATION AND QUALITY CONTROL
# ========================================

# Enable strict result validation
HYBRID_VALIDATION_STRICT=true

# Require all fields to be present in results
HYBRID_VALIDATION_REQUIRE_ALL_FIELDS=false

# ========================================
# MONITORING AND LOGGING
# ========================================

# Enable performance monitoring
HYBRID_MONITORING_ENABLED=true

# Logging level: debug, info, warn, error
HYBRID_LOG_LEVEL=info

# ========================================
# PERFORMANCE OPTIMIZATION SETTINGS
# ========================================

# These settings can be tuned based on your performance requirements:

# For maximum speed and cost savings (rules-only):
# HYBRID_LLM_FALLBACK_ENABLED=false
# HYBRID_RULES_CONFIDENCE_THRESHOLD=0.6
# HYBRID_MONITORING_ENABLED=false

# For maximum accuracy (hybrid with LLM validation):
# HYBRID_LLM_FALLBACK_ENABLED=true
# HYBRID_RULES_CONFIDENCE_THRESHOLD=0.8
# HYBRID_VALIDATION_STRICT=true

# For development and testing:
# HYBRID_LOG_LEVEL=debug
# HYBRID_MONITORING_ENABLED=true
# HYBRID_LLM_MAX_RETRIES=1

# ========================================
# USAGE EXAMPLES
# ========================================

# Example 1: Rules-only processing (fastest, no API costs)
# HYBRID_ANALYSIS_ENABLED=true
# HYBRID_LLM_FALLBACK_ENABLED=false
# HYBRID_RULES_CONFIDENCE_THRESHOLD=0.6

# Example 2: Hybrid with conservative LLM usage (balanced)
# HYBRID_ANALYSIS_ENABLED=true
# HYBRID_LLM_FALLBACK_ENABLED=true
# HYBRID_RULES_CONFIDENCE_THRESHOLD=0.8
# HYBRID_LLM_CONFIDENCE_THRESHOLD=0.7

# Example 3: Aggressive LLM usage (highest accuracy, higher costs)
# HYBRID_ANALYSIS_ENABLED=true
# HYBRID_LLM_FALLBACK_ENABLED=true
# HYBRID_RULES_CONFIDENCE_THRESHOLD=0.9
# HYBRID_LLM_CONFIDENCE_THRESHOLD=0.6